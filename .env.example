# Copy to .env.local and fill in. Never put real values in this file: it is committed.

# ------------------------------------------------------------------ Odoo CRM
# Every website form creates a crm.lead in Odoo:
#   - contact form   (/[locale]/get-in-touch)  -> POST /api/contact
#   - free audit form (/[locale]/contact)      -> POST /api/audit
#   - audit scorecard (/[locale]/scorecard)    -> POST /api/scorecard
# API key: Odoo > Preferences > Account Security > New API Key, on the user
# that should own website leads.
ODOO_BASE_URL=https://nbtlabs.odoo.com
ODOO_API_KEY_WEBSITE=

# ------------------------------------------------- Scorecard (optional extras)
# The scorecard is delivered to every configured target (Odoo above, the
# webhook, email) and succeeds if any one of them succeeds. With none set,
# POST /api/scorecard returns 500 and logs why: a lead must never be dropped silently.

# Optional webhook: each submission is POSTed here as JSON
# (see the Submission type in src/lib/audit/submission.ts).
SCORECARD_WEBHOOK_URL=
# Optional shared secret, sent as the x-nbt-signature header.
SCORECARD_WEBHOOK_SECRET=

# Optional email copy of each scored summary. Confirm host/port with your provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@nbtlabs.ca
SMTP_PASSWORD=
SCORECARD_TO=info@nbtlabs.ca
SCORECARD_FROM=info@nbtlabs.ca

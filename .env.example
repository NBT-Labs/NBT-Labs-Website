# Scorecard submissions — where a completed audit scorecard goes.
#
# Nothing here is required for the scorecard itself to work: the questions,
# the scoring and the result screen are all client-side, so the public quiz
# runs with no configuration at all. These variables only control what happens
# after someone asks for the detailed analysis.
#
# If NEITHER a webhook nor SMTP is configured, the submit endpoint returns a
# 500 and logs loudly. That is deliberate — a cheerful success response with
# nowhere to put the lead is the worst outcome once ads are running.

# ---------------------------------------------------------------- 1. Webhook
# When set, each submission is POSTed here as JSON (see the Submission type in
# src/lib/audit/submission.ts for the exact shape).
#
# This is the Odoo hook. When the CRM is ready, set this URL and no code
# changes. Run it alongside email for a week, confirm leads are landing in the
# CRM, then remove the SMTP variables — rather than cutting over blind.
SCORECARD_WEBHOOK_URL=
# Optional shared secret, sent as the x-nbt-signature header.
SCORECARD_WEBHOOK_SECRET=

# ------------------------------------------------------------------ 2. Email
# Hostinger SMTP for the nbtlabs.ca mailbox. Confirm the host and port against
# Hostinger's current settings rather than trusting these defaults.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@nbtlabs.ca
SMTP_PASSWORD=
# Who receives the scored summary, and who it appears to come from.
SCORECARD_TO=info@nbtlabs.ca
SCORECARD_FROM=info@nbtlabs.ca



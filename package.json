{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "predev": "node scripts/build-quiz-bundle.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-quiz-bundle.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/lib/audit/*.test.ts",
    "audit:validate": "cd content/audit && python3 validate.py"
  },
  "dependencies": {
    "next": "16.2.6",
    "nodemailer": "^10.0.14",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
